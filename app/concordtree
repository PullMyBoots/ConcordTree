#!/usr/bin/env bash
set -euo pipefail
concordtree_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
unset PYTHONPATH PYTHONHOME LD_PRELOAD CONCORDTREE_EXPERIMENTAL_PATTERN_BACKEND
export PATH="$concordtree_root/.conda/env/bin:/usr/lib/wsl/lib:/usr/local/nvidia/bin:/usr/bin:/bin"
export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1
concordtree_packages="$concordtree_root/.conda/env/lib/python3.10/site-packages"
export LD_LIBRARY_PATH="$concordtree_root/.web-python/lib:$concordtree_packages/torch/lib:$concordtree_root/.conda/env/lib"
for concordtree_library in "$concordtree_packages"/nvidia/*/lib; do
    [[ ! -d "$concordtree_library" ]] || LD_LIBRARY_PATH="$LD_LIBRARY_PATH:$concordtree_library"
done
export LD_LIBRARY_PATH
exec "$concordtree_root/.web-python/bin/python" -I -B "$concordtree_root/scripts/launch.py" "$@"
